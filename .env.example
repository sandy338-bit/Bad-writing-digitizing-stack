VISION_READER=ensemble
TROCR_MODEL=data/models/trocr-onnx
ENSEMBLE_CROP_LIMIT=16
SUPPORTED_LANGUAGES=English,Hindi,Tamil,Malayalam
LANGUAGE_HINT=auto
QWEN_BACKEND=ollama
QWEN_LOCAL_MODEL=qwen2.5vl:3b
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3-vl-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=
ENABLE_PADDLE_OCR=true
MAX_UPLOAD_MB=15
ACCEPT_THRESHOLD=0.75
DATABASE_PATH=data/scrawlguard.sqlite3
MAX_PENDING_JOBS=8
MODEL_TIMEOUT_SECONDS=60
MAX_REGIONS=80
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
